# Create a Resend account, verify a sending domain, and use its API key.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=BoardExamTracker <alerts@boardexamtracker.com>
PUBLIC_BASE_URL=https://your-boardexamtracker-domain.example
CRON_SECRET=generate-a-long-random-secret-and-set-the-same-value-in-Vercel-and-Cloudflare
PRC_CHECKER_URL=https://boardexamtracker-prc-checker.boardexamtracker.workers.dev

# Private admin access. Use a unique long password and a random secret of at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Subscriber dashboard sessions. Falls back to ADMIN_SESSION_SECRET if unset.
SUBSCRIBER_SESSION_SECRET=

# Ganap.net payment gateway (optional). Ganap requires a minimum ₱200 charge;
# configure prepaid options in admin so ₱20/month equivalent is preserved.
GANAP_PROJECT_UUID=
GANAP_SECRET_KEY=
GANAP_API_BASE=https://api.ganap.net

# Persistent subscriber storage and shared live-viewer count (Upstash Redis REST credentials).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configure after AdSense approves the site and creates the display ad unit.
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=ca-pub-replace-with-your-publisher-id
ADSENSE_SLOT_ID_RESULTS=replace-with-your-results-ad-unit-id
